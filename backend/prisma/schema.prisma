// SRE (Sagar Roadways and Enterprises) — Hamali Management System
// Phase 1 schema. Modeled directly on SR_HAMALI_2026-27.xlsx's real, current
// calculation logic (verified via formula inspection, not guessed):
//
//   Company Deduction = Amount * companyDeductionPct         (e.g. 10%)
//   Balance            = Amount - Company Deduction
//   Labour Deduction   = Balance * labourDeductionPct         (e.g. 20%, of the REMAINDER, not of Amount)
//   Net Amount         = Balance - Labour Deduction
//   Per Person          = SUM(Net Amount for the day) / PresentCount
//
// PresentCount is a manual daily headcount, independent of entry count —
// it is NOT derived from counting work_entries. Modeled as its own table.
//
// Percentages are per calculation_rules, versioned by effective date, because
// the workbook shows the business changing the percentage mid-year
// (30% flat -> 20% flat -> 10%+20% staged). Never hardcode a percentage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  LABOUR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EntryStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum LoadUnload {
  LOAD
  UNLOAD
}

model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Labour-specific profile info (only meaningful when role = LABOUR)
  labourProfile LabourProfile?

  // Owner-specific permission grants (only meaningful when role = OWNER)
  ownerPermission OwnerPermission?

  entriesCreated   WorkEntry[]      @relation("EntryCreatedBy")
  entriesUpdated   WorkEntry[]      @relation("EntryUpdatedBy")
  entriesApproved  WorkEntry[]      @relation("EntryApprovedBy")
  financialsEntered EntryFinancial[] @relation("FinancialCreatedBy")
  financialsUpdated EntryFinancial[] @relation("FinancialUpdatedBy")
  auditLogs        AuditLog[]

  @@map("users")
}

model LabourProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  employeeCode  String     @unique
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  attendance    DailyAttendance[]

  @@map("labourers")
}

// Owner permissions are explicit grants, per spec section 3/47 ("Configurable").
// Absence of a row (or a false flag) means denied — never default-allow.
model OwnerPermission {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])
  canViewFinancials     Boolean  @default(false)
  canEditAmount         Boolean  @default(false)
  canApproveEntries     Boolean  @default(false)
  canCancelEntries      Boolean  @default(false)
  canManageCompanies    Boolean  @default(false)
  canViewFinancialReports Boolean @default(false)
  canExportExcel        Boolean  @default(false)
  canExportPdf          Boolean  @default(false)
  canViewAuditLogsLimited Boolean @default(false)
  updatedAt             DateTime @updatedAt

  @@map("owner_permissions")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  phone     String?
  address   String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   WorkEntry[]

  @@map("companies")
}

// Vehicle "Type" as a managed list (Admin-configurable), replacing the
// free-text mess found in the workbook (909 / 9090 / 99 / 40FT / 40 FT ...).
model VehicleType {
  id        String   @id @default(uuid())
  name      String   @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())

  entries   WorkEntry[]

  @@map("vehicle_types")
}

// Operational data only. No financial fields here — enforced by table
// separation, not just by API filtering.
model WorkEntry {
  id             String      @id @default(uuid())
  date           DateTime    @db.Date
  vehicleNo      String
  vehicleTypeId  String
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id])
  loadUnload     LoadUnload
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  remark         String?
  status         EntryStatus @default(PENDING)

  createdById    String
  createdBy      User        @relation("EntryCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?       @relation("EntryUpdatedBy", fields: [updatedById], references: [id])
  approvedById   String?
  approvedBy     User?       @relation("EntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  financial      EntryFinancial?

  @@index([date])
  @@index([companyId])
  @@index([vehicleNo])
  @@index([status])
  @@map("work_entries")
}

// Financial data lives in a separate table so it can be excluded entirely
// from any Labour-scoped Prisma query (select-level, not just JSON filtering).
model EntryFinancial {
  id                  String   @id @default(uuid())
  workEntryId         String   @unique
  workEntry           WorkEntry @relation(fields: [workEntryId], references: [id])

  amount              Decimal  @db.Decimal(10, 2)

  companyDeductionPct Decimal  @db.Decimal(5, 2) // snapshot of rule at entry time
  companyDeduction    Decimal  @db.Decimal(10, 2)
  balanceAfterCompany Decimal  @db.Decimal(10, 2)

  labourDeductionPct  Decimal  @db.Decimal(5, 2) // snapshot of rule at entry time
  labourDeduction     Decimal  @db.Decimal(10, 2)

  netAmount           Decimal  @db.Decimal(10, 2)

  createdById         String
  createdBy           User     @relation("FinancialCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?    @relation("FinancialUpdatedBy", fields: [updatedById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("entry_financials")
}

// Manual daily headcount — the workbook's "Present" column is NOT derived
// from entry count. One row per calendar day.
model DailyAttendance {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  labourId      String
  labour        LabourProfile @relation(fields: [labourId], references: [id])
  present       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, labourId])
  @@index([date])
  @@map("daily_attendance")
}

// Versioned, admin-configurable calculation rules. New rows are added when
// percentages change; existing entry_financials keep their snapshot values,
// so past reports never silently recalculate under a new rule.
model CalculationRule {
  id                  String   @id @default(uuid())
  effectiveFrom       DateTime @db.Date
  companyDeductionPct Decimal  @db.Decimal(5, 2)
  labourDeductionPct  Decimal  @db.Decimal(5, 2)
  otherDeductionPct   Decimal  @db.Decimal(5, 2) @default(0)
  note                String?
  createdAt           DateTime @default(now())

  @@index([effectiveFrom])
  @@map("calculation_rules")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "ENTRY_UPDATED", "AMOUNT_CHANGED", "LOGIN"
  entityType String   // e.g. "WorkEntry", "EntryFinancial", "User"
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
